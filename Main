  <div class="grid">
    <!-- Game 1: GBA Emulator -->
    <div class="card" onclick="loadGBA()">
      <h3>GBA Games</h3>
      <p>Pokemon, Zelda, Mario</p>
    </div>

    <!-- Game 2: N64 Emulator -->
    <div class="card" onclick="loadN64()">
      <h3>N64 Games</h3>
      <p>Super Mario 64, Kart</p>
    </div>

    <!-- Game 3: GeForce NOW Free Stream -->
    <div class="card" onclick="loadCloud()">
      <h3>GeForce NOW</h3>
      <p>Free Cloud Stream (1hr sessions)</p>
    </div>
  </div>

  <div id="game-box"></div>

  <script>
    // Loads EmulatorJS for GBA
    function loadGBA() {
      document.getElementById('game-box').innerHTML = `<div id="game"></div>`;
      EJS_player = '#game';
      EJS_core = 'gba';
      EJS_gameUrl = 'YOUR_DIRECT_ROM_LINK.gba'; // Replace with link to a .gba file hosted online
      EJS_pathtodata = 'https://cdn.emulatorjs.org/stable/data/';
      
      let script = document.createElement('script');
      script.src = 'https://cdn.emulatorjs.org/stable/data/loader.js';
      document.body.appendChild(script);
    }

    // Loads EmulatorJS for N64
    function loadN64() {
      document.getElementById('game-box').innerHTML = `<div id="game"></div>`;
      EJS_player = '#game';
      EJS_core = 'n64';
      EJS_gameUrl = 'YOUR_DIRECT_ROM_LINK.z64'; // Replace with link to a .z64 file
      EJS_pathtodata = 'https://cdn.emulatorjs.org/stable/data/';
      
      let script = document.createElement('script');
      script.src = 'https://cdn.emulatorjs.org/stable/data/loader.js';
      document.body.appendChild(script);
    }

    // Loads GeForce NOW in iframe
    function loadCloud() {
      document.getElementById('game-box').innerHTML = 
        `<iframe src="https://play.geforcenow.com" allow="gamepad; autoplay; fullscreen"></iframe>`;
    }
  </script>
