function loadGameFrame(title) {
    // Exact file paths inside your GitHub repository
    const gamePaths = {
        'Eaglercraft': './eaglercraft.html', // This must match your file name in GitHub
        'FNAF: Security Breach': './fnaf.html',
        'Cuphead': './cuphead.html',
        'COD Zombies': './cod.html'
    };

    const path = gamePaths[title];

    if (path) {
        // Embeds the local repository HTML directly without external blocking
        winBody.innerHTML = `<iframe src="${path}" class="window-content" style="width:100%; height:100%; border:none;" allow="fullscreen; autoplay; pointer-lock"></iframe>`;
    } else {
        alert('Game path not configured! Please upload the game HTML file to your repository.');
    }
}
